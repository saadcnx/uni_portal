# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Database
MONGODB_URI=mongodb://localhost:27017/lms

# Authentication & JWT
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_minimum_32_characters_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=

# Initial Super Admin Seed Credentials
SEED_SUPER_ADMIN_EMAIL=superadmin@lms.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
